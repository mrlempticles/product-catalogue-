# Environment Variables
#
# Copy this file to .env and fill in any values you want to override.
# The defaults below are suitable for local development.
#
# !! Never commit .env to git — it is listed in .gitignore !!

# Port the Express server listens on
PORT=3000

# API version to activate: v1.0 | v1.1 | v2.0
#
# v1.0 → GET /health, GET /products
# v1.1 → + GET /products/search?keyword=
# v2.0 → + category, minPrice, maxPrice filters on /products/search
APP_VERSION=v1.0
